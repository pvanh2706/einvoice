# Keeping capture sources immutable also preserves literal XML whitespace.
src/eInvoice.Providers/Vnpt/Generated/** linguist-generated=true whitespace=-blank-at-eol
tools/RemainingFixtureCapture/Frozen/** linguist-generated=true whitespace=-blank-at-eol
tools/RemainingFixtureCapture/Current/** linguist-generated=true whitespace=-blank-at-eol
